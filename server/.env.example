NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Production requires HTTPS and a local filesystem for DATA_DIR.
# FILES_DIR=/root/PDSDrive/团队空间/huanxue/infinite-canvas/files
# BACKUP_DIR=/root/PDSDrive/团队空间/huanxue/infinite-canvas/backups
# STORAGE_SENTINEL=/root/PDSDrive/团队空间/huanxue/infinite-canvas/.canvas-storage
# MASTER_KEY_FILE=/etc/infinite-canvas/master.key
MAX_ROOM_CONNECTIONS=50
MAX_SYNC_BYTES=1048576
MAX_FILE_BYTES=20971520
API_TIMEOUT_MS=120000
SESSION_TTL_MS=86400000
SHARE_TTL_MS=604800000
SYNC_BATCH_MS=150
AUTH_ATTEMPTS_PER_MINUTE=10
WRITES_PER_MINUTE=600
API_CONCURRENCY=2
BACKUP_INTERVAL_MS=60000
# Empty by default; the administrator can also approve domains in the UI.
API_ALLOWED_HOSTS=
